import "../assets/Vazir.ttf";
import "../assets/Vazir-Bold.ttf";
import { ScrollView, CheckBox, Slider, AboutSlint, Palette } from "std-widgets.slint";
export { Palette } from "std-widgets.slint";

export struct EqBand { frequency: string, gain: float }
export struct LevelPoint { input: float, output: float }
export struct ConflictRow { pid: int, name: string, exe: string }
export struct LogRow { time: string, level: string, message: string }

export global Locale { in-out property <bool> rtl: true; }

global Colors {
    out property <color> bg: #090e22;
    out property <color> panel: #142039da;
    out property <color> raised: #00193f;
    out property <color> border: #263e62;
    out property <color> accent: #74aaf1;
    out property <color> text: #eff5ff;
    out property <color> muted: #a4b6d2;
}

component Action inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked();
    min-height: 36px;
    max-height: 36px;
    preferred-height: 36px;
    vertical-stretch: 0;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.selected ? Colors.accent : Colors.border;
    background: transparent;
    property <float> visual-scale: !root.enabled ? 1 : touch.pressed ? 0.98 : touch.has-hover ? 1.02 : 1;
    animate visual-scale { duration: 150ms; easing: cubic-bezier(0.16,1,0.3,1); }
    Rectangle { x: (root.width - self.width)/2; y: (root.height - self.height)/2; width: root.width * root.visual-scale; height: root.height * root.visual-scale;
        border-radius: 14px; background: !root.enabled ? #0c162b : touch.pressed ? #06132d : touch.has-hover ? #0b2b58 : #00193f;
        drop-shadow-color: touch.has-hover && root.enabled ? #58b3f238 : #58b3f200; drop-shadow-blur: 16px;
        animate background, drop-shadow-color { duration: 150ms; easing: ease-out; }
        Rectangle { border-radius: 14px; background: transparent; border-width: root.selected || touch.pressed ? 1px : 0px; border-color: #81dfff60; drop-shadow-color: touch.has-hover && root.enabled ? #6fceff36 : transparent; drop-shadow-blur: 4px; animate drop-shadow-color { duration: 150ms; } }
    }
    animate border-color { duration: 180ms; easing: ease-out; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    Text { width: parent.width; height: parent.height; y: touch.pressed ? 1px : 0px; animate y { duration: 100ms; easing: ease-out; } text: root.text; color: root.enabled ? Colors.text : #6a7c99; font-size: 12px; font-weight: root.primary ? 700 : 500; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    focus := FocusScope { enabled: root.enabled; key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } return reject; } }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
    if focus.has-focus: Rectangle { border-radius: 14px; border-width: 1px; border-color: Colors.accent; background: transparent; }
}


component Toggle inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    in property <bool> compact: false;
    callback toggled();
    min-height: 35px; preferred-height: 35px; vertical-stretch: 0;
    min-width: root.compact ? 95px : 130px; background: transparent;
    forward-focus: focus;
    accessible-role: checkbox; accessible-label: root.text; accessible-checked: root.checked; accessible-enabled: root.enabled;
    accessible-action-default => { root.flip(); }
    function flip() { if root.enabled { root.checked = !root.checked; root.toggled(); } }
    Rectangle { width: 48px; height: 28px; x: Locale.rtl ? parent.width - self.width : 0px; y: (parent.height - self.height)/2;
        border-radius: 14px; background: !root.enabled ? #142039 : root.checked ? #126a87 : #233553; border-width: 1px; border-color: focus.has-focus ? Colors.accent : #466589;
        animate background, border-color { duration: 200ms; easing: ease-out; }
        property <length> target-x: root.checked != Locale.rtl ? 24px : 3px;
        Rectangle { x: thumb.x - 5px; y: -3px; width: 32px; height: 32px; border-radius: 16px; background: #74d8ff; opacity: touch.has-hover && root.enabled ? 0.15 : 0; animate opacity { duration: 150ms; } }
        thumb := Rectangle { x: parent.target-x; y: 3px; width: abs(self.x - parent.target-x) > 0.5px ? 26px : 22px; height: 22px; border-radius: 11px; background: root.enabled ? #eef7ff : #75859d;
            animate x { duration: 240ms; easing: cubic-bezier(0.2, 1.04, 0.3, 1); }
            animate width { duration: 110ms; easing: ease-out; }
        }
    }
    Text { horizontal-alignment: Locale.rtl ? right : left; x: Locale.rtl ? 0px : 59px; width: max(0px, parent.width - 59px); height: parent.height; text: root.text; color: root.enabled ? Colors.text : Colors.muted; font-size: 12px; vertical-alignment: center; overflow: elide; }
    focus := FocusScope { enabled: root.enabled; key-pressed(e) => { if e.text == " " || e.text == Key.Return { root.flip(); return accept; } return reject; } }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.flip(); } }
}

component HelpButton inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <string> label;
    width: 18px; height: 18px;
    border-radius: 9px; border-width: 1px; border-color: touch.has-hover || focus.has-focus ? Colors.accent : #4b6689;
    background: touch.pressed ? #06132d : touch.has-hover ? #0b2b58 : #00193f;
    animate background, border-color { duration: 140ms; easing: ease-out; }
    accessible-role: button; accessible-label: root.label;
    accessible-action-default => { root.open-help(); }
    forward-focus: focus;
    public function open-help() { popup.show(); }
    public function close-help() { popup.close(); }
    Text { width: parent.width; height: parent.height; text: "?"; color: #bfefff; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    focus := FocusScope { key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.open-help(); return accept; } return reject; } }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.open-help(); } }
    popup := PopupWindow {
        x: Locale.rtl ? 0px : root.width - 300px; y: -133px; width: 300px; height: 126px;
        close-policy: close-on-click-outside;
        forward-focus: popup-focus;
        popup-focus := FocusScope {
            key-pressed(event) => { if event.text == Key.Escape || event.text == Key.Return { root.close-help(); return accept; } return reject; }
            Rectangle { border-radius: 16px; border-width: 1px; border-color: #4d7594; background: #0c1b37; drop-shadow-color: #00000080; drop-shadow-blur: 18px;
                VerticalLayout { padding: 13px; spacing: 6px;
                    Rectangle { height: 22px; background: transparent;
                        Text { x: Locale.rtl ? 28px : 0px; width: parent.width - 28px; height: parent.height; horizontal-alignment: Locale.rtl ? right : left; vertical-alignment: center; text: root.title; color: Colors.text; font-size: 12px; font-weight: 700; }
                        Rectangle { x: Locale.rtl ? 0px : parent.width - self.width; width: 22px; height: 22px; border-radius: 11px; border-width: 1px; border-color: close-touch.has-hover ? Colors.accent : #456487; background: close-touch.pressed ? #06132d : close-touch.has-hover ? #0b2b58 : #00193f;
                            Text { width: parent.width; height: parent.height; text: "×"; color: Colors.text; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
                            close-touch := TouchArea { mouse-cursor: pointer; clicked => { root.close-help(); } }
                        }
                    }
                    Text { horizontal-alignment: Locale.rtl ? right : left; text: root.message; color: #c4d4e9; font-size: 11px; wrap: word-wrap; vertical-stretch: 1; }
                }
            }
        }
    }
}

component ComboBox inherits Rectangle {
    in property <[string]> model;
    in property <bool> enabled: true;
    in-out property <int> current-index: 0;
    property <string> current-value: root.model[root.current-index];
    property <bool> expanded: false;
    callback selected(string);
    min-height: 36px; preferred-height: 36px; vertical-stretch: 0;
    min-width: 150px; horizontal-stretch: 1;
    border-radius: 12px; border-width: 1px;
    border-color: focus.has-focus || root.expanded ? Colors.accent : Colors.border;
    background: !root.enabled ? #0c162b : touch.pressed ? #06132d : touch.has-hover ? #0b2b58 : #00193f;
    animate background, border-color { duration: 160ms; easing: ease-out; }
    accessible-role: combobox; accessible-enabled: root.enabled;
    accessible-value: root.current-value;
    accessible-expandable: true; accessible-expanded: root.expanded;
    accessible-action-expand => { root.open-menu(); }
    forward-focus: focus;
    public function choose(index: int) {
        if root.enabled && root.model.length > 0 {
            root.current-index = clamp(index, 0, root.model.length - 1);
            root.selected(root.model[root.current-index]);
        }
    }
    public function open-menu() { if root.enabled && root.model.length > 0 { popup.show(); } }
    public function close-menu() { popup.close(); root.expanded = false; }
    FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch; padding-left: 12px; padding-right: 12px; spacing: 8px;
        Text { layout-order: Locale.rtl ? 0 : 0; horizontal-stretch: 1; horizontal-alignment: Locale.rtl ? right : left; text: root.current-value; color: root.enabled ? Colors.text : Colors.muted; overflow: elide; vertical-alignment: center; }
        Text { layout-order: Locale.rtl ? -1 : 1; text: root.expanded ? "−" : "+"; width: 15px; color: Colors.muted; vertical-alignment: center; horizontal-alignment: center; }
    }
    focus := FocusScope { enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.UpArrow { root.choose(root.current-index - 1); return accept; }
            if event.text == Key.DownArrow { root.choose(root.current-index + 1); return accept; }
            if event.text == Key.Return || event.text == " " { root.open-menu(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.open-menu(); } }
    popup := PopupWindow {
        x: 0px; y: root.height + 6px; width: root.width;
        height: min(root.model.length, 6) * 38px + 16px;
        close-policy: close-on-click-outside;
        forward-focus: menu-focus;
        menu-focus := FocusScope {
            focus-changed-event => { root.expanded = self.has-focus; }
            key-pressed(event) => {
                if event.text == Key.Escape || event.text == Key.Return { root.close-menu(); return accept; }
                if event.text == Key.UpArrow { root.choose(root.current-index - 1); return accept; }
                if event.text == Key.DownArrow { root.choose(root.current-index + 1); return accept; }
                return reject;
            }
            Rectangle { border-radius: 23px; border-width: 1px; border-color: Colors.border; background: #0c1b37;
                property <float> reveal: menu-focus.has-focus ? 1 : 0;
                animate reveal { duration: 200ms; easing: cubic-bezier(0.16,1,0.3,1); }
                x: (parent.width - self.width)/2; y: 0px;
                width: parent.width * (0.95 + 0.05 * self.reveal);
                height: parent.height * (0.95 + 0.05 * self.reveal);
                opacity: self.reveal;
                ScrollView { content-y: -max(0, root.current-index - 5) * 38px; VerticalLayout { padding: 8px; spacing: 2px; alignment: start;
                    for item[i] in root.model: Rectangle {
                        min-height: 36px; max-height: 36px; vertical-stretch: 0; border-radius: 10px;
                        background: row-touch.pressed ? #06132d : row-touch.has-hover || i == root.current-index ? #00193f : transparent;
                        border-width: i == root.current-index ? 1px : 0px; border-color: Colors.accent;
                        animate background { duration: 140ms; easing: ease-out; }
                        Text { horizontal-alignment: Locale.rtl ? right : left; x: 10px; width: parent.width - 20px; height: parent.height; y: menu-focus.has-focus ? 0px : -6px; opacity: menu-focus.has-focus ? 1 : 0; animate y, opacity { duration: 160ms; delay: min(i, 12) * 18ms; easing: cubic-bezier(0.16,1,0.3,1); } text: item; color: Colors.text; overflow: elide; vertical-alignment: center; }
                        row-touch := TouchArea { mouse-cursor: pointer; clicked => { root.choose(i); root.close-menu(); } }
                    }
                } }
            }
        }
    }
}


component TargetSlider inherits Rectangle {
    in property <bool> enabled: true;
    in property <float> minimum: 0; in property <float> maximum: 200;
    in property <float> value: 100;
    callback changed(float);
    min-height: 34px; preferred-height: 34px; vertical-stretch: 0;
    forward-focus: focus;
    accessible-role: slider; accessible-value: root.value;
    accessible-value-minimum: root.minimum; accessible-value-maximum: root.maximum;
    accessible-action-set-value(v) => { if root.enabled { root.changed(clamp(v.to-float(), root.minimum, root.maximum)); } }
    property <float> position: clamp((root.value - root.minimum) / max(1, root.maximum - root.minimum), 0, 1);
    function update-pointer() { if root.enabled { root.changed(root.minimum + (Locale.rtl ? 1 - clamp((touch.mouse-x - 9px) / max(1px, root.width - 18px), 0, 1) : clamp((touch.mouse-x - 9px) / max(1px, root.width - 18px), 0, 1)) * (root.maximum - root.minimum)); } }
    Rectangle { x: 9px; width: parent.width - 18px; height: 5px; y: (parent.height - self.height)/2; border-radius: 3px; background: Colors.border;
        Rectangle { width: parent.width * root.position; x: Locale.rtl ? parent.width - self.width : 0px; background: root.enabled ? #67caff : #435575; border-radius: 3px; }
    }
    Rectangle { width: touch.pressed ? 20px : 17px; height: self.width; x: 9px + (root.width - 18px) * (Locale.rtl ? 1 - root.position : root.position) - self.width/2; y: (parent.height - self.height)/2; border-radius: self.width/2; background: root.enabled ? #83ddff : #66768f; border-width: 3px; border-color: #c8ebff65;
        drop-shadow-color: root.enabled && (touch.has-hover || focus.has-focus) ? #64cdff75 : #64cdff28; drop-shadow-blur: 14px;
        animate width, drop-shadow-color { duration: 150ms; easing: ease-out; }
    }
    focus := FocusScope { enabled: root.enabled; key-pressed(e) => {
        if e.text == Key.LeftArrow { root.changed(clamp(root.value + (Locale.rtl ? 1 : -1), root.minimum, root.maximum)); return accept; }
        if e.text == Key.RightArrow { root.changed(clamp(root.value + (Locale.rtl ? -1 : 1), root.minimum, root.maximum)); return accept; }
        if e.text == Key.Home { root.changed(root.minimum); return accept; }
        if e.text == Key.End { root.changed(root.maximum); return accept; } return reject;
    } }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; pointer-event(e) => { if e.kind == PointerEventKind.down { focus.focus(); root.update-pointer(); } } moved => { if self.pressed { root.update-pointer(); } } }
}

component SpinBox inherits Rectangle {
    in property <int> minimum: 0; in property <int> maximum: 200;
    in-out property <int> value: 0; in property <bool> enabled: true;
    callback edited();
    property <bool> text-dirty: false;
    out property <string> input-text: editor.text;
    changed value => { editor.text = root.value; }
    public function enter-text(text: string) { editor.text = text; root.text-dirty = true; root.apply-text(); }
    min-width: 142px; preferred-height: 36px; min-height: 36px; vertical-stretch: 0;
    forward-focus: editor;
    function apply-text() { root.value = clamp(round(editor.text.to-float()), root.minimum, root.maximum); root.edited(); editor.text = root.value; root.text-dirty = false; }
    HorizontalLayout { spacing: 6px; alignment: center;
        Action { text: "−"; width: 30px; enabled: root.enabled && root.value > root.minimum; clicked => { root.value = max(root.minimum, root.value - 1); root.edited(); } }
        Rectangle { horizontal-stretch: 1; min-width: 66px; border-radius: 12px; border-width: 1px; border-color: editor.has-focus ? Colors.accent : Colors.border; background: #00193f;
            animate border-color { duration: 160ms; }
            editor := TextInput { x: 6px; width: parent.width - 12px; height: parent.height; text: root.value; input-type: number; enabled: root.enabled; color: root.enabled ? Colors.text : Colors.muted; font-size: 13px; vertical-alignment: center; horizontal-alignment: center;
                edited => { root.text-dirty = true; }
                accepted => { root.apply-text(); root.text-dirty = false; }
                // Commit after typing, so entering 100 does not first select 1.
                changed has-focus => { if !self.has-focus && root.text-dirty { root.apply-text(); root.text-dirty = false; } }
            }
        }
        Action { text: "+"; width: 30px; enabled: root.enabled && root.value < root.maximum; clicked => { root.value = min(root.maximum, root.value + 1); root.edited(); } }
    }
}

component EqFader inherits Rectangle {
    in property <string> frequency;
    in property <float> value;
    in property <bool> enabled: true;
    callback changed(float);
    min-width: 30px; horizontal-stretch: 1;
    forward-focus: focus;
    accessible-role: slider; accessible-label: root.frequency + " Hz";
    accessible-value: root.value; accessible-value-minimum: -12; accessible-value-maximum: 12;
    accessible-action-set-value(v) => { if root.enabled { root.changed(clamp(v.to-float(), -12, 12)); } }
    function pointer-value() { root.changed(round(clamp(12 - 24 * (touch.mouse-y - 28px) / max(1px,root.height - 55px), -12, 12) * 2) / 2); }
    Text { x: 0px; y: 0px; text: (root.value > 0 ? "+" : "") + root.value; color: root.enabled ? #8be2eb : Colors.muted; font-size: 10px; height: 20px; width: parent.width; horizontal-alignment: center; }
    rail := Rectangle { y: 28px; height: root.height - 55px; width: 4px; x: (root.width - self.width)/2; border-radius: 2px; background: #304563;
        Rectangle { y: root.value >= 0 ? parent.height * (12-root.value)/24 : parent.height/2; height: parent.height * abs(root.value)/24; background: root.enabled ? #5ed9e5 : #63758c; border-radius: 2px; }
    }
    Rectangle { y: rail.y + rail.height/2; x: root.width/2 - 9px; width: 18px; height: 1px; background: #527294; }
    Rectangle { width: touch.pressed ? 25px : 22px; height: 11px; x: (root.width - self.width)/2; y: rail.y + rail.height * (12-clamp(root.value,-12,12))/24 - self.height/2; border-radius: 5px; background: root.enabled ? #83dfea : #687a95; border-width: 1px; border-color: #d3ffff75;
        drop-shadow-blur: 12px; drop-shadow-color: touch.has-hover || focus.has-focus ? #65d8ea80 : #65d8ea22;
        animate width, drop-shadow-color { duration: 140ms; easing: ease-out; }
    }
    Text { text: root.frequency; color: Colors.muted; font-size: 10px; y: parent.height - 19px; height: 19px; width: parent.width; horizontal-alignment: center; }
    focus := FocusScope { enabled: root.enabled; key-pressed(e) => {
        if e.text == Key.UpArrow { root.changed(min(12,root.value + 0.5)); return accept; }
        if e.text == Key.DownArrow { root.changed(max(-12,root.value - 0.5)); return accept; }
        if e.text == Key.Home { root.changed(0); return accept; } return reject;
    } }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; pointer-event(e) => { if e.kind == PointerEventKind.down { focus.focus(); root.pointer-value(); } } moved => { if self.pressed { root.pointer-value(); } } }
}

component Meter inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <float> level;
    in property <color> tint: Colors.accent;
    in property <bool> bipolar: false;
    in property <float> gain-db: 0;
    out property <length> track-width: track.width;
    out property <length> fill-width: fill.width;
    out property <length> fill-x: fill.x;
    background: Colors.panel; border-width: 1px; border-color: #41567780;
    border-radius: 22px;
    VerticalLayout {
        padding: 15px;
        spacing: 9px;
        Rectangle { height: 24px;
            Rectangle { x: Locale.rtl ? parent.width * 0.60 + 3px : 0px; width: parent.width * 0.40 - 3px; height: parent.height; clip: true;
                Text { width: parent.width; height: parent.height; horizontal-alignment: Locale.rtl ? right : left; vertical-alignment: center; text: root.label; color: Colors.muted; font-size: 11px; overflow: elide; }
            }
            Rectangle { x: Locale.rtl ? 0px : parent.width * 0.40 + 3px; width: parent.width * 0.60 - 3px; height: parent.height; clip: true;
                Text { width: parent.width; height: parent.height; text: root.value; color: Colors.text; font-size: 14px; font-weight: 700; horizontal-alignment: Locale.rtl ? left : right; vertical-alignment: center; overflow: elide; }
            }
        }
        track := Rectangle { height: 6px; border-radius: 3px; background: Colors.border;
            // Symmetric display range: +/-24 dB. Larger values saturate visually.
            fill := Rectangle {
                width: root.bipolar ? parent.width / 2 * clamp(abs(root.gain-db) / 24, 0, 1) : parent.width * clamp(root.level, 0, 1);
                x: root.bipolar ? (parent.width / 2 - ((root.gain-db < 0) != Locale.rtl ? self.width : 0px)) : (Locale.rtl ? parent.width - self.width : 0px);
                height: parent.height; border-radius: 3px;
                background: root.bipolar ? (root.gain-db >= 0 ? Colors.accent : #92aaff) : root.tint;
                animate width { duration: 140ms; easing: ease-out; }
            }
            if root.bipolar: Rectangle { x: parent.width / 2 - 1px; y: -2px; width: 2px; height: parent.height + 4px; border-radius: 1px; background: #b5c7df; }
        }
    }
}

component TechnologyCredit inherits Rectangle {
    in property <image> logo;
    in property <string> version;
    in property <string> website;
    callback clicked();
    height: 120px;
    vertical-stretch: 0;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        alignment: start;
        Image {
            source: root.logo;
            preferred-width: 256px;
            height: 48px;
            vertical-stretch: 0;
            image-fit: contain;
            colorize: Colors.text;
        }
        Text {
            text: "Version " + root.version + "\n" + root.website;
            color: Colors.text;
            font-size: 10px;
            horizontal-alignment: center;
        }
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component PageSurface inherits Rectangle {
    in property <bool> active;
    opacity: root.active ? 1 : 0;
    visible: root.opacity > 0.001;
    x: root.active ? 0px : Locale.rtl ? -16px : 16px;
    animate opacity, x { duration: 220ms; easing: cubic-bezier(0.2, 0, 0, 1); }
}


component NavAction inherits Rectangle {
    in property <string> text; in property <image> icon;
    in property <bool> selected: false; in property <bool> expanded: true;
    in property <int> order: 0;
    out property <length> icon-local-x: nav-icon.x;
    out property <bool> icon-aligned: abs(nav-icon.x - (Locale.rtl ? root.width - nav-icon.width - 15px : 15px)) < 0.1px;
    callback clicked();
    min-height: 38px; max-height: 38px; preferred-height: 38px; vertical-stretch: 0; border-radius: 23px;
    drop-shadow-color: touch.has-hover ? #59bef832 : transparent; drop-shadow-blur: 12px; animate drop-shadow-color { duration: 150ms; } border-width: 1px;
    border-color: root.selected ? #6d98c999 : #38507760;
    background: touch.pressed ? #06132d : touch.has-hover ? #153354 : root.selected ? #163353 : #00193f;
    animate background, border-color { duration: 180ms; easing: ease-out; }
    accessible-role: button; accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    nav-icon := Image { source: root.icon; width: 22px; height: 22px; x: Locale.rtl ? parent.width - self.width - 15px : 15px; y: (parent.height - self.height)/2; colorize: root.selected ? #77e2ef : #acc2dc; animate colorize { duration: 180ms; easing: ease-out; } }
    Text { horizontal-alignment: Locale.rtl ? right : left; x: Locale.rtl ? 10px : 48px; width: max(0px,parent.width - 58px); height: parent.height; text: root.text; color: Colors.text; font-size: 13px; font-weight: root.selected ? 700 : 500; vertical-alignment: center; opacity: root.expanded ? 1 : 0; animate opacity { duration: 180ms; delay: root.expanded ? root.order * 18ms : 0ms; easing: ease-out; } overflow: elide; }
    focus := FocusScope { key-pressed(e) => { if e.text == Key.Return || e.text == " " { root.clicked(); return accept; } return reject; } }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
    if focus.has-focus: Rectangle { background: transparent; border-radius: 23px; border-width: 1px; border-color: Colors.accent; }
}
export component AppWindow inherits Window {
    init => { Palette.color-scheme = ColorScheme.dark; Locale.rtl = !root.english; }
    changed english => { Locale.rtl = !root.english; }
    title: "MAXI SOUNDSET";
    icon: @image-url("../assets/icon.png");
    preferred-width: 1280px;
    preferred-height: 860px;
    min-width: 1120px;
    min-height: 760px;
    background: @linear-gradient(135deg, #090e22 0%, #00193f 100%);
    default-font-family: "Vazir";
    default-font-size: 13px;

    in-out property <bool> english: false;
    in-out property <int> page: 0;
    in-out property <int> target: 100;
    in-out property <int> boost: 24;
    in-out property <int> reaction: 1;
    in-out property <int> intensity: 1;
    in-out property <int> mode: 0;
    in-out property <int> profile: 1;
    in property <[EqBand]> eq-bands;
    in-out property <string> volume-notice;
    in-out property <string> audio-error;
    property <int> target-maximum: root.mode == 0 ? 100 : 200;
    property <[string]> profile-names: root.english ? ["System default", "Gentle", "Voice / dialogue", "Music", "Cinema", "Warm & relaxed", "Gaming focus", "Custom equalizer"] : ["پیش‌فرض سیستم", "ملایم", "گفتار و دیالوگ", "موسیقی", "سینما", "گرم و آرام", "تمرکز بازی", "اکولایزر سفارشی"];
    in-out property <int> last-profile: 1;
    in-out property <bool> leveling: true;
    in-out property <bool> treble-smoothing: true;
    in-out property <bool> startup: true;
    in-out property <bool> startup-active: false;
    in property <string> startup-message;
    in property <string> app-version;
    property <string> version-label: "v1.0.0";
    out property <string> sidebar-brand-text: root.english ? "MAXI\nSOUNDSET" : "مکسی سَوندسِت";
    out property <string> log-label: root.english ? "Log" : "لاگ";
    out property <string> gain-label: root.english ? "GAIN" : "بهره صدا";
    in property <string> rust-version;
    in property <string> slint-version: "1.18.0";
    in property <string> dependency-versions;
    in-out property <int> app-update-state: 0; // 0 idle, 1 checking, 2 current, 3 available, 4 error
    in-out property <string> app-latest-version: "";
    in property <[ConflictRow]> conflicts;
    in property <string> conflict-message;
    property <int> pending-conflict: -1;
    property <string> pending-name;
    in-out property <bool> sidebar-expanded: true;
    out property <string> exact-target-text: exact-target.input-text;
    public function enter-target-text(text: string) { exact-target.enter-text(text); }
    out property <bool> sidebar-on-right: sidebar-panel.x > body-host.x;
    out property <bool> sidebar-icon-aligned: sound-nav.icon-aligned;
    in property <string> deess-text: "−0.0 dB";
    in property <float> deess-level: 0;
    in property <string> input-path;
    in property <string> output-path;
    in-out property <float> graph-width: 1;
    in-out property <float> graph-height: 1;
    property <string> profile-name: root.profile-names[root.profile];
    in-out property <bool> auto-route: true;
    in-out property <bool> debug-log: false;
    in-out property <int> output-index: 0;
    in-out property <int> source-index: 0;
    in property <[string]> outputs;
    in property <[string]> sources;
    in property <bool> running: false;
    in property <bool> paused: false;
    in property <bool> busy: false;
    in property <bool> devices-ready: false;
    in property <bool> recovery-ready: false;
    out property <bool> cable-warning-visible: root.devices-ready && !root.cable-installed;
    out property <bool> enhancement-hint-visible: root.profile != 0 && root.mode == 0;
    out property <bool> minimum-size-valid: root.width >= 1120px && root.height >= 760px;
    out property <bool> sound-layout-fits: control-strip.x >= 0px && control-strip.x + control-strip.width <= body-host.width && target-card.x >= 0px && target-card.x + target-card.width <= body-host.width && enhancement-card.y + enhancement-card.height <= body-host.height && tuning-card.y + tuning-card.height <= body-host.height;
    out property <length> playback-device-width: playback-device-field.width;
    out property <length> processing-mode-width: processing-mode-field.width;
    in property <bool> limited: false;
    in property <bool> boost-limited: false;
    in property <string> status: "Ready";
    in property <string> input-text: "0";
    in property <string> output-text: "0";
    in property <string> gain-text: "0.0 dB";
    in property <float> gain-db: 0;
    out property <length> input-meter-width: input-meter.width;
    out property <length> output-meter-width: output-meter.width;
    out property <length> gain-meter-width: gain-meter.width;
    out property <length> input-track-width: input-meter.track-width;
    out property <length> input-fill-width: input-meter.fill-width;
    out property <length> input-fill-x: input-meter.fill-x;
    out property <length> output-track-width: output-meter.track-width;
    out property <length> output-fill-width: output-meter.fill-width;
    out property <length> output-fill-x: output-meter.fill-x;
    out property <length> gain-track-width: gain-meter.track-width;
    out property <length> gain-fill-width: gain-meter.fill-width;
    out property <length> gain-fill-x: gain-meter.fill-x;
    out property <bool> about-rights-fits: about-rights.y + about-rights.height <= about-overview.height - 16px;
    out property <bool> about-cards-separated: about-overview.y + about-overview.height < about-tech.y;
    out property <bool> about-notices-fit: about-notices.y + about-notices.height <= body-host.height;
    out property <bool> about-credits-fit: rust-credit.y + rust-credit.height <= about-tech.y + about-tech.height - 22px && slint-credit.y + slint-credit.height <= about-tech.y + about-tech.height - 22px;
    out property <bool> about-layout-fits: root.about-rights-fits && root.about-cards-separated && root.about-notices-fit && root.about-credits-fit;
    in property <float> input-level: 0;
    in property <float> output-level: 0;
    in property <[LogRow]> logs;
    in property <string> component-status: "Checking installed audio devices…";
    in property <string> installed-version: "";
    in property <string> latest-version: "";
    in property <bool> cable-installed: false;
    in property <bool> update-available: false;
    in property <bool> components-busy: false;
    in property <float> download-progress: 0;
    in property <string> component-message: "";
    in property <string> log-folder: "";

    callback startup-changed();
    callback refresh-conflicts();
    callback end-conflict(int);
    callback toggle-audio();
    callback toggle-pause();
    callback config-changed();
    callback eq-band-changed(int, float);
    callback reset-equalizer();
    callback refresh-devices();
    callback install-components();
    callback check-updates();
    callback check-app-update();
    callback open-licenses();
    callback open-log-folder();
    callback open-log-file();
    callback open-link(string);
    callback clear-log-view();
    callback exit-app();
    public function set-enhancement(on: bool) { if on { root.profile = clamp(root.last-profile, 1, 7); } else { if root.profile != 0 { root.last-profile = root.profile; } root.profile = 0; } root.config-changed(); }
    public function choose-profile(index: int) { root.profile = index; if index != 0 { root.last-profile = index; } root.config-changed(); }
    public function preview-menu() { reaction-menu.open-menu(); }
    public function close-preview-menu() { reaction-menu.close-menu(); }
    public function preview-profile-menu() { profile-menu.open-menu(); }
    public function close-profile-menu() { profile-menu.close-menu(); }
    public function preview-routing-help() { routing-help.open-help(); }
    public function close-routing-help() { routing-help.close-help(); }


    FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch; spacing: 0px;
        sidebar-panel := Rectangle { layout-order: Locale.rtl ? 0 : 0;
            width: root.sidebar-expanded ? 216px : 84px;
            animate width { duration: 330ms; easing: cubic-bezier(0.2,1.03,0.3,1); }
            background: @linear-gradient(180deg, #172338ee 0%, #0b1329f5 100%);
            border-width: 1px; border-color: #40547470; clip: true;
            VerticalLayout { padding: 16px; spacing: 8px;
                FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: root.sidebar-expanded ? stretch : center; height: 43px; spacing: root.sidebar-expanded ? 10px : 0px;
                    
                    if root.sidebar-expanded: Rectangle { layout-order: Locale.rtl ? -1 : 1; horizontal-stretch: 1; background: transparent; }
                    Action { layout-order: Locale.rtl ? -2 : 2; text: ""; accessible-label: "Toggle sidebar"; width: 36px; clicked => { root.sidebar-expanded = !root.sidebar-expanded; }
                        Image { source: (root.sidebar-expanded == Locale.rtl) ? @image-url("../assets/chevron-right.svg") : @image-url("../assets/chevron-left.svg"); width: 20px; height: 20px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                    }
                }
                if !root.sidebar-expanded: Image { source: @image-url("../assets/sidebar-logo.svg"); width: 52px; height: 52px; image-fit: contain; }
                if root.sidebar-expanded: VerticalLayout { spacing: 5px;
                    Text { horizontal-alignment: Locale.rtl ? right : left; text: root.sidebar-brand-text; color: Colors.text; font-size: 20px; font-weight: 800; }
                    Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "Better sound for you" : "صدای بهتر برای تو"; color: Colors.muted; font-size: 10px; }
                }
                Rectangle { height: 1px; background: #41567765; }
                ScrollView { vertical-stretch: 1; horizontal-stretch: 1; VerticalLayout { spacing: 6px; alignment: start;
                sound-nav := NavAction { order: 0; text: root.english ? "Sound" : "صدا"; icon: @image-url("../assets/nav-sound.svg"); expanded: root.sidebar-expanded; selected: root.page == 0; clicked => { root.page = 0; } }
                NavAction { order: 2; text: root.english ? "Components" : "افزونه‌ها"; icon: @image-url("../assets/nav-components.svg"); expanded: root.sidebar-expanded; selected: root.page == 1; clicked => { root.page = 1; } }
                NavAction { order: 3; text: root.log-label; icon: @image-url("../assets/nav-log.svg"); expanded: root.sidebar-expanded; selected: root.page == 2; clicked => { root.page = 2; } }
                NavAction { order: 4; text: root.english ? "Settings" : "تنظیمات"; icon: @image-url("../assets/nav-settings.svg"); expanded: root.sidebar-expanded; selected: root.page == 4; clicked => { root.page = 4; } }
                NavAction { order: 5; text: (root.english ? "Audio conflicts" : "تداخل صوتی") + (root.conflicts.length > 0 ? " (" + root.conflicts.length + ")" : ""); icon: @image-url("../assets/nav-conflicts.svg"); expanded: root.sidebar-expanded; selected: root.page == 5; clicked => { root.page = 5; root.refresh-conflicts(); } }
                NavAction { order: 6; text: root.english ? "About" : "درباره برنامه"; icon: @image-url("../assets/nav-about.svg"); expanded: root.sidebar-expanded; selected: root.page == 6; clicked => { root.page = 6; } }
                } }
                if root.cable-warning-visible: Rectangle {
                    height: root.sidebar-expanded ? 105px : 38px;
                    background: #503a2233; border-radius: 12px; border-width: 1px; border-color: #d5a16670;
                    Text { x: 10px; y: 8px; width: parent.width - 20px; height: parent.height - 16px; text: root.sidebar-expanded ? (root.english ? "For better results and full app functionality, install the virtual cable add-on from Components." : "برای نتیجهٔ بهتر و استفادهٔ کامل از قابلیت‌های نرم‌افزار، افزونهٔ کابل مجازی را از بخش افزونه‌ها نصب کنید.") : "⚠"; color: #e5b585; font-size: root.sidebar-expanded ? 11px : 20px; wrap: word-wrap; horizontal-alignment: root.sidebar-expanded ? (Locale.rtl ? right : left) : center; vertical-alignment: center; }
                    TouchArea { mouse-cursor: pointer; clicked => { root.page = 1; } }
                }
                NavAction { text: root.english ? "Donate" : "دونیت"; icon: @image-url("../assets/nav-donate.svg"); expanded: root.sidebar-expanded; clicked => { root.open-link("https://maxispace.dev/donate"); } }
                NavAction { text: root.english ? "فارسی / FA" : "English / EN"; icon: @image-url("../assets/nav-language.svg"); expanded: root.sidebar-expanded; clicked => { root.english = !root.english; root.config-changed(); } }
                if root.sidebar-expanded: Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "X keeps Maxi running in the tray." : "ضربدر: ادامهٔ اجرا کنار ساعت"; color: Colors.muted; font-size: 10px; wrap: word-wrap; }
                NavAction { text: root.english ? "Exit app" : "خروج از برنامه"; icon: @image-url("../assets/nav-exit.svg"); expanded: root.sidebar-expanded; clicked => { root.exit-app(); } }
                Text { text: root.version-label; color: Colors.muted; font-size: 10px; horizontal-alignment: center; }
            }
        }
        body-host := Rectangle { layout-order: Locale.rtl ? -1 : 1; horizontal-stretch: 1; clip: true;
            Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; background: @linear-gradient(125deg, #090e2200 0%, #16abbf10 45%, #090e2200 100%); }
        PageSurface { width: parent.width; height: parent.height; active: root.page == 0;
        VerticalLayout { padding: 23px; spacing: 14px;
            control-strip := Rectangle { height: 82px; border-radius: 23px; background: Colors.panel; border-width: 1px; border-color: #41567780;
                FlexboxLayout { padding: 12px; flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch; spacing: 8px;
                    playback-device-field := VerticalLayout { layout-order: 0; width: root.mode == 1 ? max(120px, (parent.width - 356px) * 4 / 13) : max(120px, (parent.width - 348px) * 4 / 9); spacing: 5px;
                        Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "PLAYBACK DEVICE" : "دستگاه پخش"; color: Colors.muted; font-size: 10px; }
                        ComboBox { min-width: 104px; model: root.outputs; current-index <=> root.output-index; enabled: root.devices-ready && root.recovery-ready && !root.running && !root.busy; selected(value) => { root.config-changed(); } }
                    }
                    processing-mode-field := VerticalLayout { layout-order: Locale.rtl ? -1 : 1; width: root.mode == 1 ? max(150px, (parent.width - 356px) * 5 / 13) : max(150px, (parent.width - 348px) * 5 / 9); spacing: 5px;
                        Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "PROCESSING MODE" : "حالت پردازش"; color: Colors.muted; font-size: 10px; }
                        ComboBox { min-width: 130px; model: root.english ? ["Windows volume", "Full boost / virtual cable"] : ["صدای ویندوز", "بوست کامل / کابل مجازی"]; current-index <=> root.mode; enabled: root.devices-ready && root.recovery-ready && !root.running && !root.busy; selected(value) => { root.config-changed(); } }
                    }
                    if root.mode == 1: virtual-input-field := VerticalLayout { layout-order: Locale.rtl ? -2 : 2; width: max(120px, (parent.width - 356px) * 4 / 13); spacing: 5px;
                        Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "VIRTUAL INPUT" : "ورودی مجازی"; color: Colors.muted; font-size: 10px; }
                        ComboBox { min-width: 120px; model: root.sources; current-index <=> root.source-index; enabled: root.devices-ready && root.recovery-ready && !root.running && !root.busy; selected(value) => { root.config-changed(); } }
                    }
                    playback-control-field := VerticalLayout { layout-order: Locale.rtl ? -3 : 3; width: 268px; spacing: 5px;
                        Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "PLAYBACK CONTROL" : "کنترل پخش"; color: Colors.muted; font-size: 10px; }
                        FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch; spacing: 4px;
                            Action { layout-order: 0; width: 50px; text: root.english ? "Run" : "اجرا"; primary: true; enabled: root.devices-ready && root.recovery-ready && !root.running && !root.busy && !root.components-busy; clicked => { root.toggle-audio(); } }
                            Action { layout-order: Locale.rtl ? -1 : 1; width: 50px; text: root.english ? "Stop" : "توقف"; enabled: root.running && !root.busy; clicked => { root.toggle-audio(); } }
                            Action { layout-order: Locale.rtl ? -2 : 2; width: 58px; text: root.paused ? (root.english ? "Resume" : "ادامه") : (root.english ? "Pause" : "مکث"); enabled: root.running && !root.busy; clicked => { root.toggle-pause(); } }
                            Rectangle { layout-order: Locale.rtl ? -3 : 3; width: 98px; border-radius: 13px; border-width: 1px; border-color: #345571; background: #0c1b32;
                                Text { width: parent.width; height: parent.height; text: root.running && !root.paused ? (root.english ? "● Active" : "● فعال") : (root.english ? "○ Standby" : "○ آماده‌به‌کار"); color: root.running && !root.paused ? #77e1df : Colors.muted; horizontal-alignment: center; vertical-alignment: center; font-size: 10px; }
                            }
                        }
                    }
                    refresh-field := VerticalLayout { layout-order: Locale.rtl ? -4 : 4; width: 32px; spacing: 5px;
                        Rectangle { height: 14px; background: transparent; }
                        Action { width: 32px; text: ""; accessible-label: root.english ? "Refresh devices" : "به‌روزرسانی دستگاه‌ها"; enabled: !root.running && !root.busy; clicked => { root.refresh-devices(); }
                            Image { source: @image-url("../assets/refresh.svg"); width: 17px; height: 17px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                        }
                    }
                }
            }
            FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch; spacing: 16px;
                VerticalLayout { layout-order: Locale.rtl ? 0 : 0; width: 260px; spacing: 14px;
                    target-card := Rectangle { height: 304px; border-radius: 24px; background: Colors.panel; border-width: 1px; border-color: #41567780;
                        VerticalLayout { padding: 16px; spacing: 4px;
                            Text { text: root.leveling ? (root.english ? "SOUND TARGET" : "بلندی صدای هدف") : (root.english ? "MANUAL VOLUME / BOOST" : "ولوم / بوست دستی"); color: Colors.muted; font-size: 11px; horizontal-alignment: center; }
                            Text { text: root.target; color: Colors.text; font-size: 50px; font-weight: 800; horizontal-alignment: center; height: 66px; }
                            Text { text: "/ " + root.target-maximum; color: Colors.muted; font-size: 12px; horizontal-alignment: center; height: 17px; }
                            TargetSlider { minimum: 0; maximum: root.target-maximum; value: root.target; changed(v) => { root.target = round(v); root.config-changed(); } }
                            FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch;
                                Text { layout-order: Locale.rtl ? 0 : 0; horizontal-stretch: 1; horizontal-alignment: Locale.rtl ? right : left; text: "0"; color: Colors.muted; font-size: 10px; }
                                Text { layout-order: Locale.rtl ? -1 : 1; horizontal-stretch: 1; text: root.leveling ? (root.english ? "LOUDNESS TARGET" : "شاخص بلندی صدا") : (root.english ? "MANUAL LEVEL" : "سطح دستی"); color: Colors.muted; font-size: 9px; horizontal-alignment: center; }
                                Text { layout-order: Locale.rtl ? -2 : 2; horizontal-stretch: 1; text: root.target-maximum; color: Colors.muted; font-size: 10px; horizontal-alignment: Locale.rtl ? left : right; }
                            }
                            Rectangle { height: 1px; background: Colors.border; }
                            FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch; spacing: 8px;
                                Text { layout-order: Locale.rtl ? 0 : 0; horizontal-stretch: 1; horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "Exact target" : "عدد دقیق"; color: Colors.muted; font-size: 11px; vertical-alignment: center; }
                                exact-target := SpinBox { layout-order: Locale.rtl ? -1 : 1; width: 142px; minimum: 0; maximum: 200; value <=> root.target; edited => { root.config-changed(); } }
                            }
                            Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "PRESETS" : "حالت‌های آماده"; color: Colors.muted; font-size: 10px; }
                            FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch; spacing: 7px;
                                Action { layout-order: Locale.rtl ? 0 : 0; text: root.english ? "Quiet" : "آرام"; selected: root.target == 65; clicked => { root.target = 65; root.config-changed(); } }
                                Action { layout-order: Locale.rtl ? -1 : 1; text: root.english ? "Daily" : "روزمره"; selected: root.target == 100; clicked => { root.target = 100; root.config-changed(); } }
                                Action { layout-order: Locale.rtl ? -2 : 2; text: root.english ? "Loud" : "بلند"; selected: root.target == 140; clicked => { root.target = 140; root.config-changed(); } }
                            }
                        }
                    }
                    enhancement-card := Rectangle { vertical-stretch: 1; min-height: 257px; border-radius: 24px; background: Colors.panel; border-width: 1px; border-color: #41567780;
                        VerticalLayout { padding: 12px; spacing: 3px; alignment: start;
                            Toggle { text: root.english ? "Steady loudness" : "ثابت ماندن بلندی"; checked <=> root.leveling; toggled => { root.config-changed(); } }
                            Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "STEADYING INTENSITY" : "شدت ثابت‌سازی"; color: Colors.muted; font-size: 10px; }
                            ComboBox { model: root.english ? ["High", "Balanced", "Low"] : ["زیاد", "متعادل", "کم"]; current-index <=> root.intensity; enabled: root.leveling; selected(value) => { root.config-changed(); } }
                            Rectangle { height: 1px; background: Colors.border; }
                            Toggle { text: root.english ? "Sound enhancement" : "بهبود کیفیت صدا"; checked: root.profile != 0; toggled => { root.set-enhancement(self.checked); } }
                            Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "AUDIO PROFILE" : "پروفایل صوتی"; color: Colors.muted; font-size: 10px; }
                            profile-menu := ComboBox { model: root.profile-names; current-index <=> root.profile; selected(value) => { root.choose-profile(root.profile); } }
                            Text { height: 14px; horizontal-alignment: Locale.rtl ? right : left; text: root.profile == 0 ? (root.english ? "System tone · enhancement off" : "رنگ صدای سیستم؛ بهبوددهنده خاموش") : root.enhancement-hint-visible ? (root.english ? "Requires Full boost / virtual cable mode." : "نیازمند حالت بوست کامل / کابل مجازی") : (root.english ? ["", "Natural tone.", "Clearer dialogue with less boom.", "Gentle warmth for music.", "Fuller lows and clearer dialogue.", "Relaxed treble for longer listening.", "Clearer cues with lighter bass.", "Your independent 10-band equalizer."][root.profile] : ["", "رنگ طبیعی صدا.", "گفتار روشن‌تر با بم کمتر.", "گرمای ملایم برای موسیقی.", "بم پرتر و دیالوگ واضح‌تر.", "صدای زیر آرام‌تر برای شنیدن طولانی.", "نشانه‌های روشن‌تر با بم کمتر.", "اکولایزر مستقل ۱۰ باندی شما."][root.profile]); color: root.enhancement-hint-visible ? #e5b585 : Colors.muted; font-size: 10px; overflow: elide; }
                            Rectangle { height: 1px; background: Colors.border; }
                            Toggle { min-height: 30px; preferred-height: 30px; text: root.english ? "Treble smoothing" : "نرم‌سازی صدای تیز"; checked <=> root.treble-smoothing; enabled: root.profile != 0; toggled => { root.config-changed(); } }
                            Text { height: 13px; horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "Dynamic reduction only when harsh treble dominates" : "کاهش پویا فقط هنگام غالب‌شدن صدای تیز"; color: Colors.muted; font-size: 9px; overflow: elide; }
                            treble-meter := Rectangle { height: 18px; background: transparent;
                                property <float> active-level: root.mode == 1 && root.profile != 0 && root.treble-smoothing ? clamp(root.deess-level, 0, 1) : 0;
                                Text { x: Locale.rtl ? 0px : parent.width - 58px; width: 58px; height: parent.height; text: root.mode == 1 && root.profile != 0 && root.treble-smoothing ? root.deess-text : "−0.0 dB"; color: #81dfe3; font-size: 9px; horizontal-alignment: Locale.rtl ? left : right; vertical-alignment: center; }
                                treble-track := Rectangle { x: Locale.rtl ? 64px : 0px; width: parent.width - 64px; height: 5px; y: (parent.height - self.height) / 2; border-radius: 3px; background: Colors.border;
                                    Rectangle { width: parent.width * treble-meter.active-level; x: Locale.rtl ? 0px : parent.width - self.width; border-radius: 3px; background: #54dfdf; animate width { duration: 140ms; easing: ease-out; } }
                                }
                            }
                            Rectangle { vertical-stretch: 1; background: transparent; }
                        }
                    }
                }
                VerticalLayout { layout-order: Locale.rtl ? -1 : 1; horizontal-stretch: 1; spacing: 12px;
                    Rectangle {
                        vertical-stretch: 1; min-height: 148px; border-radius: 24px; background: Colors.panel; border-width: 1px; border-color: #41567780;
                        VerticalLayout {
                            padding: 16px; spacing: 10px;
                            FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch;
                                Text { layout-order: Locale.rtl ? 0 : 0; horizontal-stretch: 1; horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "LIVE SOUND" : "صدای زنده"; color: Colors.text; font-weight: 700; font-size: 12px; }
                                Text { layout-order: Locale.rtl ? -1 : 1; horizontal-stretch: 1; text: "● " + (root.english ? "INPUT" : "ورودی"); color: Colors.accent; font-size: 10px; horizontal-alignment: Locale.rtl ? left : right; }
                                Text { layout-order: Locale.rtl ? -2 : 2; horizontal-stretch: 1; text: "● " + (root.english ? "OUTPUT" : "خروجی"); color: #54dfdf; font-size: 10px; horizontal-alignment: Locale.rtl ? left : right; }
                            }
                            graph := Rectangle {
                                vertical-stretch: 1; background: #090e22; border-radius: 18px; clip: true;
                                for line[i] in [0, 1, 2, 3]: Rectangle { x: 0; width: graph.width; height: 1px; y: graph.height * (i + 1) / 5; background: #172b49; }
                                Rectangle { x: 0; y: graph.height / 2; height: 1px; width: graph.width; background: #294b72; }
                                changed width => { root.graph-width = self.width / 1px; }
                                changed height => { root.graph-height = self.height / 1px; }
                                Path { x: 0px; y: 0px; width: graph.width; height: graph.height; viewbox-width: root.graph-width; viewbox-height: root.graph-height; fit: fill; commands: root.input-path; fill: @linear-gradient(90deg, #548df192 0%, #467cda04 100%); stroke: #609eed; stroke-width: 2px; }
                                Path { x: 0px; y: 0px; width: graph.width; height: graph.height; viewbox-width: root.graph-width; viewbox-height: root.graph-height; fit: fill; commands: root.output-path; fill: @linear-gradient(90deg, #26d5d8a0 0%, #21b9cf05 100%); stroke: #58e8e8; stroke-width: 2px; }
                            }
                            FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch; Text { layout-order: Locale.rtl ? 0 : 0; horizontal-stretch: 1; horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "12 seconds" : "۱۲ ثانیه"; color: #8399b8; font-size: 10px; } Text { layout-order: Locale.rtl ? -1 : 1; horizontal-stretch: 1; text: ""; color: root.running ? Colors.accent : Colors.muted; font-size: 10px; horizontal-alignment: Locale.rtl ? left : right; } }
                        }
                    }

                    Rectangle { height: root.profile == 7 ? 190px : 0px; vertical-stretch: 0; clip: true; opacity: root.profile == 7 ? 1 : 0; visible: self.opacity > 0.001; animate height, opacity { duration: 220ms; easing: cubic-bezier(0.16,1,0.3,1); } border-radius: 24px; background: Colors.panel; border-width: 1px; border-color: #41567780;
                        VerticalLayout { padding: 15px; spacing: 8px;
                            FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch;
                                Text { layout-order: Locale.rtl ? 0 : 0; horizontal-stretch: 1; horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "CUSTOM EQUALIZER · dB" : "اکولایزر سفارشی · dB"; color: Colors.text; font-size: 11px; font-weight: 700; }
                                Action { layout-order: Locale.rtl ? -1 : 1; text: root.english ? "Reset" : "بازنشانی"; width: 76px; min-height: 24px; max-height: 24px; clicked => { root.reset-equalizer(); } }
                            }
                            HorizontalLayout { spacing: 3px; vertical-stretch: 1;
                                VerticalLayout { width: 25px; padding-top: 22px; padding-bottom: 20px; spacing: 0; Text { text: "+12"; color: Colors.muted; font-size: 9px; } Rectangle { vertical-stretch: 1; } Text { text: "0"; color: Colors.muted; font-size: 9px; } Rectangle { vertical-stretch: 1; } Text { text: "−12"; color: Colors.muted; font-size: 9px; } }
                                for band[i] in root.eq-bands: EqFader { enabled: root.profile == 7; frequency: band.frequency; value: band.gain; changed(v) => { root.eq-band-changed(i, v); } }
                            }
                        }
                    }
                    meter-row := Rectangle { height: 72px; background: transparent;
                        input-meter := Meter { width: (meter-row.width - 20px) / 3; height: 72px; x: Locale.rtl ? 2 * (self.width + 10px) : 0px; label: root.english ? "INPUT" : "ورودی"; value: root.input-text; level: root.input-level; }
                        output-meter := Meter { width: (meter-row.width - 20px) / 3; height: 72px; x: self.width + 10px; label: root.english ? (root.mode == 0 ? "OUTPUT · EST." : "OUTPUT") : (root.mode == 0 ? "خروجی · تقریبی" : "خروجی"); value: root.output-text; level: root.output-level; tint: #54dfdf; }
                        gain-meter := Meter { width: (meter-row.width - 20px) / 3; height: 72px; x: Locale.rtl ? 0px : 2 * (self.width + 10px); label: root.gain-label + (root.boost-limited ? (root.english ? " · CEILING" : " · سقف") : root.limited ? (root.english ? " · PROTECTED" : " · محافظت") : ""); value: root.gain-text; bipolar: true; gain-db: root.gain-db; }
                    }
                    tuning-card := Rectangle {
                        height: 106px; background: Colors.panel; border-width: 1px; border-color: #41567780; border-radius: 24px;
                        FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch;
                            padding: 15px; spacing: 12px;
                            VerticalLayout { layout-order: Locale.rtl ? 0 : 0; horizontal-stretch: 1; spacing: 6px; alignment: start;
                                Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "REACTION" : "سرعت واکنش"; color: Colors.muted; font-size: 10px; height: 14px; }
                                reaction-menu := ComboBox { model: root.english ? ["Fast / gaming", "Balanced", "Smooth / music"] : ["سریع / بازی", "متعادل", "نرم / موسیقی"]; current-index <=> root.reaction; selected(value) => { root.config-changed(); } }
                            }
                            VerticalLayout { layout-order: Locale.rtl ? -1 : 1; width: 142px; spacing: 6px; alignment: start;
                                Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "MAX BOOST (dB)" : "سقف بوست (dB)"; color: Colors.muted; font-size: 10px; height: 14px; }
                                SpinBox { minimum: 0; maximum: 36; value <=> root.boost; enabled: root.mode == 1; edited => { root.config-changed(); } }
                            }
                            VerticalLayout { layout-order: Locale.rtl ? -2 : 2; width: 165px; spacing: 6px; alignment: start;
                                FlexboxLayout { height: 18px; flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: Locale.rtl ? end : start; spacing: 4px;
                                    Text { layout-order: Locale.rtl ? 1 : 0; text: root.english ? "VIRTUAL-CABLE ROUTING" : "هدایت به کابل مجازی"; color: Colors.muted; font-size: 10px; vertical-alignment: center; }
                                    routing-help := HelpButton { layout-order: Locale.rtl ? 0 : 1; title: root.english ? "Automatic routing" : "هدایت خودکار"; message: root.english ? "On: temporarily sends Windows default audio to the virtual cable and restores it on Stop.\nOff: use manual or per-app cable routing." : "روشن: خروجی پیش‌فرض ویندوز را موقتاً به کابل مجازی هدایت می‌کند و با توقف برمی‌گرداند.\nخاموش: مسیر کابل را دستی یا برای هر برنامه جداگانه تنظیم کن."; label: root.english ? "Explain virtual-cable routing" : "توضیح هدایت به کابل مجازی"; }
                                }
                                Toggle { text: root.english ? "Automatic" : "خودکار"; checked <=> root.auto-route; enabled: root.mode == 1 && !root.running && !root.busy; toggled => { root.config-changed(); } }
                                Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "Changes defaults · restored on Stop" : "تغییر پیش‌فرض‌ها؛ بازگشت در توقف"; color: #8399b8; font-size: 9px; height: 12px; }
                            }
                        }
                    }
                }
            }
        }
        if root.volume-notice != "" || root.audio-error != "": Rectangle { x: 23px; y: parent.height - self.height - 23px; width: parent.width - 46px; height: 70px; border-radius: 18px; background: #112743f5; border-width: 1px; border-color: #73cddb; drop-shadow-color: #00000070; drop-shadow-blur: 18px;
            FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch; padding: 14px; spacing: 12px;
                Text { layout-order: Locale.rtl ? 0 : 0; horizontal-stretch: 1; horizontal-alignment: Locale.rtl ? right : left; text: root.audio-error != "" ? root.audio-error : root.volume-notice; color: root.audio-error != "" ? #ffc1a1 : #c2eefa; wrap: word-wrap; vertical-alignment: center; font-size: 12px; }
                Action { layout-order: Locale.rtl ? -1 : 1; text: "×"; width: 36px; clicked => { root.volume-notice = ""; root.audio-error = ""; } }
            }
        }
        }

        PageSurface { width: parent.width; height: parent.height; active: root.page == 1; VerticalLayout {
            padding: 28px; spacing: 19px;
            FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch;
                VerticalLayout { layout-order: Locale.rtl ? 0 : 0; horizontal-stretch: 1; spacing: 6px;
                    Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "Audio components" : "افزونه‌ها و ابزارهای صوتی"; color: Colors.text; font-size: 24px; font-weight: 750; }
                    Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "Install or update what full audio processing needs." : "وابستگی مورد نیاز بوست کامل را از همین‌جا نصب یا آپدیت کن."; color: Colors.muted; }
                }
                Action { layout-order: Locale.rtl ? -1 : 1; text: root.english ? "Check for updates" : "بررسی آپدیت"; width: 165px; enabled: !root.components-busy; clicked => { root.check-updates(); } }
            }
            Rectangle { min-height: 198px; background: Colors.panel; border-width: 1px; border-color: #41567780; border-radius: 25px;
                VerticalLayout { padding: 23px; spacing: 15px;
                    FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch;
                        VerticalLayout { layout-order: Locale.rtl ? 0 : 0; horizontal-stretch: 1; spacing: 7px; Text { horizontal-alignment: Locale.rtl ? right : left; text: "VB-CABLE"; color: Colors.text; font-size: 21px; font-weight: 750; } Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "Virtual audio driver · required for full boost" : "درایور صوتی مجازی · مورد نیاز بوست کامل"; color: Colors.muted; } }
                        Text { layout-order: Locale.rtl ? -1 : 1; horizontal-stretch: 1; text: root.cable-installed ? "● INSTALLED" : "○ NOT INSTALLED"; color: root.cable-installed ? #78d5a6 : #ffb074; horizontal-alignment: Locale.rtl ? left : right; vertical-alignment: center; font-size: 11px; }
                    }
                    Text { horizontal-alignment: Locale.rtl ? right : left; text: root.component-status; color: Colors.muted; wrap: word-wrap; }
                    FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch; Text { layout-order: Locale.rtl ? 0 : 0; horizontal-stretch: 1; horizontal-alignment: Locale.rtl ? right : left; text: root.installed-version; color: #c6d6ed; font-size: 11px; } Text { layout-order: Locale.rtl ? -1 : 1; horizontal-stretch: 1; text: root.latest-version; color: #c6d6ed; font-size: 11px; horizontal-alignment: Locale.rtl ? left : right; } }
                    FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch;
                        spacing: 12px;
                        Action { layout-order: Locale.rtl ? 0 : 0; text: root.components-busy ? (root.english ? "Please wait…" : "کمی صبر کن…") : root.cable-installed ? (root.english ? "Update / repair components" : "آپدیت / ترمیم وابستگی‌ها") : (root.english ? "Install required components" : "نصب وابستگی‌های لازم"); primary: true; width: 247px; enabled: !root.components-busy && !root.running && !root.busy; clicked => { root.install-components(); } }
                        Action { layout-order: Locale.rtl ? -1 : 1; text: root.english ? "Official website" : "وب‌سایت رسمی"; width: 137px; clicked => { root.open-link("https://vb-audio.com/Cable/"); } }
                        Text { layout-order: Locale.rtl ? -2 : 2; horizontal-stretch: 1; horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "Windows may request administrator access and a restart." : "ویندوز ممکن است دسترسی مدیر و راه‌اندازی مجدد بخواهد."; color: Colors.muted; wrap: word-wrap; font-size: 11px; vertical-alignment: center; }
                    }
                }
            }
            if root.components-busy || root.component-message != "": Rectangle {
                min-height: 87px; background: #122242; border-radius: 22px;
                VerticalLayout { padding: 17px; spacing: 12px; Text { horizontal-alignment: Locale.rtl ? right : left; text: root.component-message; color: Colors.text; wrap: word-wrap; font-size: 12px; }
                    Rectangle { height: 5px; background: Colors.border; border-radius: 3px; Rectangle { width: parent.width * clamp(root.download-progress, 0, 1); background: Colors.accent; border-radius: 3px; } }
                }
            }
            Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "The button downloads the current official driver package, opens its installer and checks the audio devices afterwards. Start full boost after Windows has made the new device available." : "دکمه، بستهٔ فعلی سازنده را دانلود و نصب‌کننده را اجرا می‌کند و بعد دستگاه‌ها را دوباره بررسی می‌کند. پس از در دسترس قرار گرفتن کابل، حالت بوست کامل را شروع کن."; color: Colors.muted; wrap: word-wrap; font-size: 12px; }
            Rectangle { vertical-stretch: 1; background: transparent; }
        } }

        PageSurface { width: parent.width; height: parent.height; active: root.page == 2; VerticalLayout {
            padding: 26px; spacing: 17px;
            FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch; spacing: 18px;
                VerticalLayout { layout-order: Locale.rtl ? 0 : 0; horizontal-stretch: 1; spacing: 5px; Text { horizontal-alignment: Locale.rtl ? right : left; text: "Activity log"; color: Colors.text; font-size: 24px; font-weight: 750; } Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "Audio events, installation progress and errors." : "رویدادهای صدا، مراحل نصب و خطاها"; color: Colors.muted; } }
                Rectangle { layout-order: Locale.rtl ? -1 : 1; width: 368px; height: 36px; vertical-stretch: 0; background: transparent;
                    FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch; spacing: 8px;
                        Toggle { layout-order: Locale.rtl ? 2 : 0; compact: true; width: 95px; text: "Debug"; checked <=> root.debug-log; toggled => { root.config-changed(); } }
                        Action { layout-order: 1; width: 128px; text: root.english ? "Open log file" : "باز کردن لاگ"; clicked => { root.open-log-file(); } }
                        Action { layout-order: Locale.rtl ? 0 : 2; width: 129px; text: root.english ? "Log folder" : "پوشهٔ لاگ"; clicked => { root.open-log-folder(); } }
                    }
                }
            }
            Rectangle {
                border-radius: 24px; background: #09132b; border-width: 1px; border-color: Colors.border;
                VerticalLayout { spacing: 0px;
                    Rectangle { height: 38px; background: Colors.raised; FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch; padding-left: 14px; padding-right: 14px; Text { layout-order: Locale.rtl ? 0 : 0; horizontal-alignment: Locale.rtl ? right : left; text: "TIME"; width: 90px; color: Colors.muted; font-size: 10px; } Text { layout-order: Locale.rtl ? -1 : 1; horizontal-alignment: Locale.rtl ? right : left; text: "LEVEL"; width: 58px; color: Colors.muted; font-size: 10px; } Text { layout-order: Locale.rtl ? -2 : 2; horizontal-stretch: 1; horizontal-alignment: Locale.rtl ? right : left; text: "EVENT"; color: Colors.muted; font-size: 10px; } } }
                    ScrollView {
                        VerticalLayout { padding: 9px; spacing: 3px; alignment: start;
                            for row in root.logs: Rectangle {
                                min-height: 36px; vertical-stretch: 0; background: row.level == "ERROR" ? #32233d : transparent; border-radius: 8px;
                                FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch; padding: 7px; spacing: 11px;
                                    Text { layout-order: Locale.rtl ? 0 : 0; horizontal-alignment: Locale.rtl ? right : left; text: row.time; color: Colors.muted; width: 79px; font-size: 11px; vertical-alignment: top; }
                                    Text { layout-order: Locale.rtl ? -1 : 1; horizontal-alignment: Locale.rtl ? right : left; text: row.level; color: row.level == "ERROR" ? #ff6e83 : row.level == "WARN" ? #ffb074 : #81d4ab; width: 50px; font-size: 10px; vertical-alignment: top; }
                                    Text { layout-order: Locale.rtl ? -2 : 2; horizontal-stretch: 1; horizontal-alignment: Locale.rtl ? right : left; text: row.message; color: #d3e0f2; font-size: 11px; wrap: word-wrap; }
                                }
                            }
                        }
                    }
                }
            }
            FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch; height: 39px;
                Text { layout-order: Locale.rtl ? 0 : 0; horizontal-stretch: 1; horizontal-alignment: Locale.rtl ? right : left; text: root.log-folder; color: Colors.muted; font-size: 10px; overflow: elide; vertical-alignment: center; }
                Action { layout-order: Locale.rtl ? -1 : 1; text: root.english ? "Clear this view" : "پاک کردن این نما"; width: 143px; clicked => { root.clear-log-view(); } }
            }
        } }


        PageSurface { width: parent.width; height: parent.height; active: root.page == 4;
            ScrollView { VerticalLayout { padding: 28px; spacing: 20px; alignment: start;
                Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "Settings" : "تنظیمات"; color: Colors.text; font-size: 28px; font-weight: 800; }
                Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "Choose Windows startup and interface language." : "اجرای خودکار با ورود به ویندوز و زبان رابط را تنظیم کن."; color: Colors.muted; wrap: word-wrap; }
                Rectangle { min-height: 260px; border-radius: 24px; background: Colors.panel; border-width: 1px; border-color: Colors.border;
                    VerticalLayout { padding: 22px; spacing: 13px; alignment: start;
                        Toggle { text: root.english ? "Run the application at startup" : "اجرای نرم افزار به صورت استارت‌آپ"; enabled: !root.busy; checked <=> root.startup; toggled => { root.startup-changed(); } }
                        Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "Starts in the background. Open Maxi from its tray icon or run the app again. Audio starts when you press Run." : "برنامه در پس‌زمینه اجرا می‌شود؛ از آیکون کنار ساعت یا اجرای دوبارهٔ برنامه بازش کن. پردازش صدا با دکمهٔ اجرا فعال می‌شود."; color: Colors.muted; font-size: 12px; wrap: word-wrap; }
                        Rectangle { height: 1px; background: Colors.border; }
                        Toggle { text: root.english ? "Keep audio active after startup" : "اکتیو بودن نرم‌افزار به صورت استارت‌آپ"; enabled: root.startup && !root.busy; checked <=> root.startup-active; toggled => { root.config-changed(); } }
                        Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "If Windows shuts down while audio is running, the app automatically resumes the last output and settings at the next startup." : "اگر هنگام خاموش شدن ویندوز پردازش صدا در حال اجرا باشد، برنامه در استارت‌آپ بعدی همان خروجی و آخرین تنظیمات را خودکار دوباره اجرا می‌کند."; color: Colors.muted; font-size: 12px; wrap: word-wrap; }
                        Text { horizontal-alignment: Locale.rtl ? right : left; text: root.startup-message; color: #8fdfdf; font-size: 11px; wrap: word-wrap; }
                    }
                }
                Rectangle { min-height: 122px; border-radius: 24px; background: Colors.panel; border-width: 1px; border-color: Colors.border;
                    VerticalLayout { padding: 22px; spacing: 13px; alignment: start;
                        FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch; spacing: 20px;
                            Text { layout-order: Locale.rtl ? 0 : 0; horizontal-stretch: 1; horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "Interface language" : "زبان رابط کاربری"; color: Colors.text; vertical-alignment: center; }
                            Action { layout-order: Locale.rtl ? -1 : 1; text: root.english ? "فارسی / FA" : "English / EN"; width: 145px; clicked => { root.english = !root.english; root.config-changed(); } }
                        }
                        Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "Persian mirrors the sidebar, menus, cards and text alignment." : "در فارسی، نوار کناری، منوها، کارت‌ها و نوشته‌ها راست‌چین می‌شوند."; color: Colors.muted; font-size: 12px; wrap: word-wrap; }
                    }
                }
            } }
        }
        PageSurface { width: parent.width; height: parent.height; active: root.page == 5;
            VerticalLayout { padding: 28px; spacing: 20px;
                FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch; spacing: 18px;
                    VerticalLayout { layout-order: Locale.rtl ? 0 : 0; horizontal-stretch: 1; spacing: 7px;
                        Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "Audio conflicts" : "تداخل برنامه‌های صوتی"; color: Colors.text; font-size: 27px; font-weight: 800; }
                        Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "Other audio processors can apply effects twice or change routing." : "پردازشگرهای صوتی دیگر ممکن است افکت‌ها را دوبار اعمال کنند یا مسیر صدا را تغییر دهند."; color: Colors.muted; wrap: word-wrap; }
                    }
                    Action { layout-order: Locale.rtl ? -1 : 1; text: root.english ? "Refresh" : "بررسی دوباره"; width: 130px; clicked => { root.refresh-conflicts(); } }
                }
                Rectangle { min-height: 91px; border-radius: 24px; background: root.conflicts.length > 0 ? #392c3c : Colors.panel; border-width: 1px; border-color: root.conflicts.length > 0 ? #d89b5960 : Colors.border;
                    VerticalLayout { padding: 20px; spacing: 10px; alignment: start;
                        Text { horizontal-alignment: Locale.rtl ? right : left; text: root.conflicts.length > 0 ? (root.english ? "Possible interference detected" : "احتمال تداخل شناسایی شد") : (root.english ? "No known audio processor detected" : "پردازشگر صوتی شناخته‌شده‌ای پیدا نشد"); color: root.conflicts.length > 0 ? #ffbf88 : #8bdfce; font-size: 16px; font-weight: 700; }
                        Text { horizontal-alignment: Locale.rtl ? right : left; text: root.conflict-message; color: Colors.muted; font-size: 11px; wrap: word-wrap; }
                    }
                }
                ScrollView { vertical-stretch: 1;
                    VerticalLayout { spacing: 12px; alignment: start;
                        for app in root.conflicts: Rectangle { min-height: 94px; border-radius: 22px; background: Colors.panel; border-width: 1px; border-color: Colors.border;
                            FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch; padding: 19px; spacing: 18px;
                                VerticalLayout { layout-order: Locale.rtl ? 0 : 0; horizontal-stretch: 1; spacing: 9px;
                                    Text { horizontal-alignment: Locale.rtl ? right : left; text: app.name; color: Colors.text; font-size: 17px; font-weight: 700; }
                                    Text { horizontal-alignment: Locale.rtl ? right : left; text: app.exe + "   ·   PID " + app.pid; color: Colors.muted; font-size: 11px; overflow: elide; }
                                }
                                Action { layout-order: Locale.rtl ? -1 : 1; text: root.english ? "End app…" : "بستن برنامه…"; width: 150px; clicked => { root.pending-conflict = app.pid; root.pending-name = app.name; } }
                            }
                        }
                    }
                }
                Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "Checks running FxSound, Voicemeeter, Peace, Sonar, Nahimic, Razer, Dolby and DTS apps. Drivers or services may remain active after their app closes. Music players alone are not conflicts." : "برنامه‌های فعال FxSound، Voicemeeter، Peace، Sonar، Nahimic، Razer، Dolby و DTS بررسی می‌شوند. درایور یا سرویس ممکن است پس از بستن برنامه فعال بماند. پخش‌کنندهٔ موسیقی به‌تنهایی تداخل محسوب نمی‌شود."; color: Colors.muted; font-size: 11px; wrap: word-wrap; }
            }
        }
        PageSurface { width: parent.width; height: parent.height; active: root.page == 6;
            VerticalLayout { padding: 28px; spacing: 20px;
                Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "About MAXI SOUNDSET" : "درباره MAXI SOUNDSET"; color: Colors.text; font-size: 28px; font-weight: 800; }
                about-overview := Rectangle { height: 278px; vertical-stretch: 0; border-radius: 24px; background: Colors.panel; border-width: 1px; border-color: Colors.border;
                    VerticalLayout { padding: 16px; spacing: 5px; alignment: start;
                        Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "MAXI SOUNDSET  ·  " + root.version-label : "مکسی سَوندسِت. نسخه ۱.۰.۰"; color: #90dfeb; font-size: 20px; font-weight: 700; }
                        Rectangle { height: 36px; vertical-stretch: 0; background: transparent;
                            update-action := Action {
                                x: Locale.rtl ? parent.width - self.width : 0px;
                                width: root.app-update-state == 3 ? 172px : 150px;
                                text: root.app-update-state == 3 ? (root.english ? "Get new version" : "دریافت نسخه جدید") : (root.english ? "Check for updates" : "بررسی بروزرسانی");
                                primary: root.app-update-state == 3;
                                selected: root.app-update-state == 3;
                                enabled: root.app-update-state != 1;
                                clicked => { if root.app-update-state == 3 { root.open-link("https://github.com/MaxiSpace/MaxiSoundSet/releases"); } else { root.check-app-update(); } }
                            }
                            Text {
                                x: root.app-update-state == 4 ? (Locale.rtl ? parent.width - update-action.width - 244px : update-action.width + 12px) : (Locale.rtl ? 0px : update-action.width + 12px);
                                width: root.app-update-state == 4 ? 220px : parent.width - update-action.width - 12px;
                                horizontal-alignment: Locale.rtl ? right : left;
                                vertical-alignment: center;
                                text: root.app-update-state == 1 ? (root.english ? "Checking GitHub…" : "در حال بررسی GitHub…")
                                    : root.app-update-state == 2 ? ((root.english ? "Latest version: " : "آخرین نسخه موجود: ") + root.app-latest-version + "  ✓")
                                    : root.app-update-state == 3 ? ((root.english ? "New version: " : "نسخه جدید: ") + root.app-latest-version + "  !")
                                    : root.app-update-state == 4 ? (root.english ? "⚠  Could not check. Try again." : "⚠  بررسی انجام نشد؛ دوباره تلاش کنید.") : "";
                                color: root.app-update-state == 2 ? #8bdfce : root.app-update-state == 3 ? #ffbf88 : root.app-update-state == 4 ? #ef9a9a : Colors.muted;
                                font-size: 12px;
                                overflow: elide;
                            }
                            Action {
                                visible: root.app-update-state == 4;
                                x: Locale.rtl ? parent.width - update-action.width - 332px : update-action.width + 244px;
                                width: 76px;
                                text: root.english ? "View log" : "مشاهده لاگ";
                                clicked => { root.open-log-file(); }
                            }
                        }
                        Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "Better sound for you · Audio processing and loudness control" : "صدای بهتر برای تو · پردازش صدا و کنترل بلندی"; color: Colors.muted; font-size: 13px; wrap: word-wrap; }
                        Text { horizontal-alignment: Locale.rtl ? right : left; text: "Windows · x64"; color: Colors.text; font-size: 13px; }
                        Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "Production year: 2026" : "سال تولید: ۲۰۲۶"; color: Colors.text; font-size: 14px; }
                        Rectangle { height: 36px; vertical-stretch: 0; background: transparent;
                            FlexboxLayout { width: 424px; height: parent.height; x: Locale.rtl ? parent.width - self.width : 0px; flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; spacing: 10px;
                                Action { layout-order: Locale.rtl ? 2 : 0; width: 132px; text: "MaxiSpace.dev  ↗"; clicked => { root.open-link("https://MaxiSpace.dev/"); } }
                                Action { layout-order: 1; width: 136px; text: root.english ? "Report an issue" : "گزارش باگ"; clicked => { root.open-link("https://github.com/MaxiSpace/MaxiSoundSet/issues"); } }
                                Action { layout-order: Locale.rtl ? 0 : 2; width: 136px; text: root.english ? "View licenses" : "مشاهده مجوزها"; clicked => { root.open-licenses(); } }
                            }
                        }
                        about-rights := Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "MAXI SOUNDSET is licensed under GNU GPL v3. Third-party notices are included in the app folder; the interface uses the Slint Royalty-free License." : "نرم‌افزار MAXI SOUNDSET تحت مجوز GNU GPL v3 منتشر می‌شود. اطلاعیه‌های اجزای ثالث در پوشهٔ برنامه قرار دارند و رابط کاربری از مجوز Slint Royalty-free استفاده می‌کند."; color: Colors.muted; font-size: 11px; wrap: word-wrap; }
                    }
                }
                about-tech := Rectangle { height: 190px; vertical-stretch: 0; border-radius: 24px; background: Colors.panel; border-width: 1px; border-color: Colors.border;
                    VerticalLayout { padding: 22px; spacing: 10px; alignment: start;
                        Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "Technology" : "فناوری ساخت"; color: Colors.text; font-weight: 700; }
                        HorizontalLayout { height: 120px; vertical-stretch: 0; spacing: 18px;
                            rust-credit := TechnologyCredit { horizontal-stretch: 1; version: root.rust-version; website: "https://www.rust-lang.org/"; logo: @image-url("../assets/rust-logo.svg"); clicked => { root.open-link("https://www.rust-lang.org/"); } }
                            slint-credit := AboutSlint { height: 120px; vertical-stretch: 0; horizontal-stretch: 1; }
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
                about-notices := Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "© 2026 MaxiSpace. All rights reserved." : "© ۲۰۲۶ MaxiSpace. تمامی حقوق این نرم‌افزار متعلق به این برند است."; color: Colors.muted; font-size: 11px; wrap: word-wrap; }
            }
        }

        }

    }
    if root.pending-conflict >= 0: Rectangle { background: #020716b0;
        TouchArea { }
        Rectangle { width: 465px; height: 230px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; border-radius: 26px; background: #10223e; border-width: 1px; border-color: Colors.accent;
            VerticalLayout { padding: 25px; spacing: 16px;
                Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "End " + root.pending-name + "?" : "بستن " + root.pending-name + "؟"; color: Colors.text; font-size: 20px; font-weight: 700; wrap: word-wrap; }
                Text { horizontal-alignment: Locale.rtl ? right : left; text: root.english ? "This ends the selected app immediately. Unsaved changes in it may be lost." : "این کار برنامهٔ انتخاب‌شده را کامل می‌بندد. تغییرات ذخیره‌نشدهٔ آن ممکن است از دست بروند."; color: Colors.muted; wrap: word-wrap; font-size: 12px; }
                FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch; spacing: 14px;
                    Action { layout-order: Locale.rtl ? 0 : 0; text: root.english ? "Cancel" : "انصراف"; clicked => { root.pending-conflict = -1; } }
                    Action { layout-order: Locale.rtl ? -1 : 1; text: root.english ? "End app" : "بستن کامل برنامه"; selected: true; clicked => { root.end-conflict(root.pending-conflict); root.pending-conflict = -1; } }
                }
            }
        }
    }

}

export component MaxiTray inherits SystemTrayIcon {
    visible: root.tray-visible;
    in-out property <bool> tray-visible: true;
    icon: @image-url("../assets/icon.png");
    tooltip: root.tray-tip;
    in property <string> tray-tip: "MAXI SOUNDSET";
    in property <bool> active: false;
    in property <bool> paused: false;
    callback show-window();
    callback toggle-pause();
    callback set-target(int);
    callback exit-app();
    clicked => { root.show-window(); }
    Menu {
        MenuItem { title: "Show MAXI SOUNDSET"; activated => { root.show-window(); } }
        MenuItem { title: root.paused ? "Resume" : "Pause"; enabled: root.active; activated => { root.toggle-pause(); } }
        Menu { title: "Sound target";
            MenuItem { title: "Quiet · 65"; activated => { root.set-target(65); } }
            MenuItem { title: "Daily · 100"; activated => { root.set-target(100); } }
            MenuItem { title: "Loud · 140"; activated => { root.set-target(140); } }
        }
        MenuSeparator { }
        MenuItem { title: "Exit app"; activated => { root.exit-app(); } }
    }
}
