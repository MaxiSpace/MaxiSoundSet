import "../../MaxiSoundSet-Rust/assets/Vazir.ttf";
import "../../MaxiSoundSet-Rust/assets/Vazir-Bold.ttf";
import { ListView, CheckBox, LineEdit, ProgressIndicator } from "std-widgets.slint";
export struct Term { heading: string, body: string }
component Button inherits Rectangle {
 in property<string> text;
 in property<bool> enabled: true;
 in property<bool> danger: false;
 callback clicked();
 height: 44px; min-width: 114px; max-width: 140px; preferred-width: 124px; horizontal-stretch: 0;
 background: transparent;
 property<float> visual-scale: !root.enabled ? 1 : hover.pressed ? 0.98 : hover.has-hover ? 1.02 : 1;
 animate visual-scale { duration: 150ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
 Rectangle {
  x: (root.width - self.width)/2; y: (root.height - self.height)/2;
  width: root.width*root.visual-scale; height: root.height*root.visual-scale; border-radius: 17px;
  background: !root.enabled ? #152038 : root.danger ? (hover.has-hover ? #77343f : #572832) : hover.pressed ? #00112d : hover.has-hover ? #0b3152 : #00193f;
  border-width: 1px; border-color: root.enabled ? (root.danger ? #bc5869 : hover.has-hover ? #80d9e9 : #588ea9) : #29384c;
  drop-shadow-color: root.enabled && hover.has-hover ? (root.danger ? #dc667940 : #69d4e840) : transparent;
  drop-shadow-blur: 16px;
  animate background, border-color, drop-shadow-color { duration: 160ms; easing: ease-out; }
 }
 Text { width: parent.width; height: parent.height; text: root.text; y: hover.pressed ? 1px : 0px; animate y { duration: 100ms; } color: root.enabled ? #f3fcff : #77899e; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
 forward-focus: focus;
 accessible-role: button; accessible-label: root.text; accessible-enabled: root.enabled;
 accessible-action-default => { if root.enabled { root.clicked(); } }
 focus := FocusScope { enabled: root.enabled; key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } return reject; } }
 hover := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
 if focus.has-focus: Rectangle { background: transparent; border-radius: 17px; border-width: 1px; border-color: #96e6f0; }
}
export component InstallerWindow inherits Window {
 title: root.english ? (root.uninstall ? "MAXI SOUNDSET Uninstaller" : "MAXI SOUNDSET Installer") : (root.uninstall ? "حذف MAXI SOUNDSET" : "نصب MAXI SOUNDSET");
 icon: @image-url("../../MaxiSoundSet-Rust/assets/icon.png");
 preferred-width: 960px; preferred-height: 720px; min-width: 860px; min-height: 650px;
 default-font-family: "Vazir"; default-font-size: 14px;
 background: @linear-gradient(150deg, #090e22 0%, #00193f 100%);
 in-out property<bool> english: false;
 in property<bool> uninstall: false;
 in-out property<int> step: 0;
 in-out property<bool> accepted: false;
 in-out property<string> install-path;
 in-out property<bool> desktop-shortcut: true;
 in-out property<bool> startup: true;
 in-out property<bool> delete-data: false;
 in-out property<bool> launch-app: true;
 in property<bool> busy: false;
 in property<bool> app-running: false;
 in property<bool> closing-app: false;
 in property<float> progress: 0;
 in property<string> message;
 in property<string> error;
 in property<string> version;
 in property<string> version-label;
 in property<[Term]> terms;
 in-out property<length> agreement-scroll-y: 0px;
 in-out property<length> agreement-content-height: 0px;
 in-out property<length> agreement-visible-height: 0px;
 property<bool> motion-ready: false;
 property<float> page-reveal: root.motion-ready ? 1 : 0;
 animate page-reveal { duration: root.motion-ready ? 240ms : 0ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
 out property<float> page-motion-progress: root.page-reveal;
 changed step => { root.motion-ready = false; }
 changed english => { root.motion-ready = false; }
 Timer { interval: 16ms; running: !root.motion-ready; triggered => { root.motion-ready = true; } }
 callback language-changed(); callback browse(); callback next(); callback back(); callback cancel();
 callback close-app();
 Rectangle { x: 6px; y: 6px; width: root.width - 12px; height: root.height - 12px; border-radius: 22px; border-width: 1px; border-color: #65b2ca70; background: transparent; }
 VerticalLayout { padding: 24px; spacing: 18px;
  HorizontalLayout { height: 54px; spacing: 16px;
   Rectangle { width: 50px; height: 50px; border-radius: 25px; border-width: 1px; border-color: #70c2d9; background: #00193f;
    Image { source: @image-url("../../MaxiSoundSet-Rust/assets/sidebar-logo.svg"); width: 42px; height: 42px; x: 4px; y: 4px; image-fit: contain; }
   }
   VerticalLayout { spacing: 1px;
    Text { text: "MAXI SOUNDSET"; color: #f3fcff; font-weight: 800; font-size: 24px; }
    Text { text: root.english ? (root.uninstall ? "Uninstaller" : "Installer") : (root.uninstall ? "حذف برنامه" : "نصب برنامه"); color: #a5bdd2; }
   }
   Button { text: root.english ? "فارسی / FA" : "English / EN"; width: 130px; enabled: !root.busy; clicked => { root.english = !root.english; root.language-changed(); } }
  }
  FlexboxLayout { flex-direction: FlexboxLayoutDirection.row; flex-wrap: no-wrap; alignment: stretch; spacing: 22px;
   Rectangle { layout-order: root.english ? 0 : 1; width: 188px; background: transparent;
    VerticalLayout { padding-top: 26px; spacing: 12px; alignment: start;
     for name[i] in [root.english ? "Welcome" : "خوش آمدید", root.english ? (root.uninstall ? "Review" : "Agreement") : (root.uninstall ? "بررسی حذف" : "توافق نامه"), root.english ? "Choose location" : "انتخاب مسیر", root.english ? (root.uninstall ? "Removing" : "Installing") : (root.uninstall ? "حذف" : "نصب"), root.english ? "Finish" : "پایان"]: Rectangle {
      visible: !root.uninstall || i != 2; height: root.uninstall && i == 2 ? 0px : 64px; border-radius: 24px;
      background: root.step == i ? #213a51 : transparent;
      border-width: 1px; border-color: root.step == i ? #478cac : transparent;
      animate border-color { duration: 200ms; easing: ease-out; }
      Rectangle { width: 3px; height: parent.height - 20px; y: 10px; x: root.english ? 0px : parent.width - 3px; border-radius: 2px; background: #69d4e8; opacity: root.step == i ? 1 : 0; animate opacity { duration: 200ms; } }
      HorizontalLayout { padding: 12px; spacing: 12px;
       Rectangle { width: 26px; background: transparent;
        Image { width: 26px; height: 26px; y: (parent.height - 26px)/2; visible: root.step <= i; image-fit: contain; colorize: root.step == i ? #69d4e8 : #72869f;
         source: i == 0 ? @image-url("../assets/step-welcome.svg") : i == 1 ? @image-url("../assets/nav-log.svg") : i == 2 ? @image-url("../assets/step-folder.svg") : i == 3 ? @image-url("../assets/nav-settings.svg") : @image-url("../assets/step-finish.svg");
        }
        Text { text: "✓"; visible: root.step > i; color: #69d4e8; vertical-alignment: center; horizontal-alignment: center; }
       }
       Text { text: name; color: root.step == i ? #f3fcff : #91a4bf; font-weight: root.step == i ? 700 : 400; vertical-alignment: center; horizontal-alignment: root.english ? left : right; }
      }
     }
    }
   }
   Rectangle { layout-order: root.english ? 1 : 0; horizontal-stretch: 1; min-width: 602px; max-width: 10000px; border-radius: 30px; border-width: 1px; border-color: #395770;
    background: #16233ae8;
    Rectangle { background: transparent; y: (1 - root.page-reveal)*8px; width: parent.width; height: parent.height; opacity: root.page-reveal;
    VerticalLayout { padding: 26px; spacing: 14px;
     if root.step == 0: VerticalLayout { alignment: center; spacing: 20px;
      HorizontalLayout { height: 170px; Rectangle { horizontal-stretch: 1; background: transparent; } Rectangle { height: 170px; width: 170px; border-radius: 85px; border-width: 2px; border-color: #69afc9; background: #00193f;
       Image { source: @image-url("../../MaxiSoundSet-Rust/assets/sidebar-logo.svg"); width: 145px; height: 145px; x: 12.5px; y: 12.5px; image-fit: contain; }
      } Rectangle { horizontal-stretch: 1; background: transparent; } }
      Text { text: root.english ? (root.uninstall ? "Remove MAXI SOUNDSET" : "Welcome to MAXI SOUNDSET") : (root.uninstall ? "حذف MAXI SOUNDSET" : "به نصب MAXI SOUNDSET خوش آمدید"); wrap: word-wrap; color: #f3fcff; font-size: 23px; font-weight: 700; horizontal-alignment: center; }
      Text { text: root.version-label; color: #a9c4d8; font-size: 18px; horizontal-alignment: center; }
      Text { text: "MaxiSpace.dev  ·  2026"; color: #a5e5ed; font-size: 15px; horizontal-alignment: center; }
      Text { text: root.english ? "All rights to this application belong to MaxiSpace.dev." : "تمامی حقوق این نرم‌افزار متعلق به برند MaxiSpace.dev است."; color: #a5b7ce; font-size: 12px; wrap: word-wrap; horizontal-alignment: center; }
      Text { text: root.english ? (root.uninstall ? "Review the files and preferences before removing the application." : "Better sound for you.\nAll application files are included in this installer.") : (root.uninstall ? "پیش از حذف، مسیر نصب و تنظیمات را بررسی کن." : "صدای بهتر برای تو\nتمام فایل های برنامه در همین نصاب قرار دارند."); color: #a5b7ce; wrap: word-wrap; horizontal-alignment: center; }
     }
     if root.step == 1 && !root.uninstall: VerticalLayout { spacing: 12px;
      Text { text: root.english ? "Terms and agreement" : "شرایط و توافق نامه"; color: #f3fcff; font-size: 23px; font-weight: 700; horizontal-alignment: root.english ? left : right; }
      Text { text: root.english ? "Full agreement · Scroll to read all 6 sections" : "متن کامل توافق‌نامه · برای مطالعهٔ هر ۶ بخش، به پایین اسکرول کنید"; color: #91a9c1; font-size: 11px; horizontal-alignment: root.english ? left : right; }
      agreement-list := ListView { vertical-stretch: 1; content-y <=> root.agreement-scroll-y;
       changed content-height => { root.agreement-content-height = self.content-height; }
       changed visible-height => { root.agreement-visible-height = self.visible-height; }
       for item in root.terms: VerticalLayout { width: agreement-list.visible-width - 14px; padding-left: 10px; padding-right: 10px; padding-bottom: 16px; spacing: 6px;
        if item.heading != "": Text { property<bool> end-marker: item.heading == (root.english ? "End of agreement" : "پایان توافق‌نامه"); width: parent.width; text: item.heading; color: self.end-marker ? #69d4e8 : #a5e5ed; font-size: self.end-marker ? 11px : 14px; font-weight: 700; wrap: word-wrap; horizontal-alignment: self.end-marker ? center : (root.english ? left : right); }
        if item.body != "": Text { width: parent.width; text: item.body; color: #d4deec; wrap: word-wrap; horizontal-alignment: root.english ? left : right; }
       }
      }
      CheckBox { text: root.english ? "I have read and accept this agreement" : "توافق نامه را خوانده ام و می پذیرم"; checked <=> root.accepted; }
     }
     if root.step == 2 || (root.step == 1 && root.uninstall): VerticalLayout { spacing: 18px; alignment: start;
      Text { text: root.english ? (root.uninstall ? "Ready to remove" : "Choose installation location") : (root.uninstall ? "آماده حذف برنامه" : "انتخاب مسیر نصب"); color: #f3fcff; font-size: 22px; font-weight: 700; horizontal-alignment: root.english ? left : right; }
      Text { text: root.english ? "Location" : "مسیر"; color: #a6bed1; horizontal-alignment: root.english ? left : right; }
      LineEdit { text <=> root.install-path; enabled: !root.uninstall; }
      if !root.uninstall: Button { text: root.english ? "Browse…" : "انتخاب پوشه…"; clicked => { root.browse(); } }
      if !root.uninstall: CheckBox { text: root.english ? "Create desktop shortcut" : "ساخت میان بر روی دسکتاپ"; checked <=> root.desktop-shortcut; }
      if !root.uninstall: CheckBox { text: root.english ? "Start with Windows" : "اجرا هنگام روشن شدن ویندوز"; checked <=> root.startup; }
      if root.uninstall: CheckBox { text: root.english ? "Also delete settings and logs" : "تنظیمات و لاگ ها هم حذف شوند"; checked <=> root.delete-data; }
      if root.uninstall && root.app-running: Rectangle { min-height: 114px; border-radius: 18px; background: #22243a; border-width: 1px; border-color: #ffb07480;
       VerticalLayout { padding: 15px; spacing: 10px;
        Text { text: root.closing-app ? (root.english ? "Waiting for safe shutdown and audio restoration…" : "در انتظار خروج امن و بازگردانی وضعیت صدا…") : (root.english ? "MAXI SOUNDSET is running. Close it before removing the application or its data." : "نرم‌افزار MAXI SOUNDSET باز است. پیش از حذف برنامه یا داده‌های آن، نرم‌افزار را ببند."); color: #ffbe8d; wrap: word-wrap; horizontal-alignment: root.english ? left : right; }
        Button { text: root.english ? "Close software" : "بستن نرم‌افزار"; enabled: !root.busy; clicked => { root.close-app(); } }
       }
      }
      Text { text: root.english ? (root.uninstall ? "Only installed application files and owned shortcuts are removed. Close the app with Exit app before continuing." : "Installation is for your current Windows account. The Start menu shortcut and Uninstall.exe are included. Audio drivers are installed separately from Components inside the app.") : (root.uninstall ? "فقط فایل های نصب شده و میان برهای همین نصب حذف می شوند. پیش از ادامه، برنامه را با خروج از برنامه ببند." : "نصب برای حساب فعلی ویندوز است. میان بر منوی شروع و Uninstall.exe نیز ساخته می شوند. درایور صوتی از تب افزونه های خود برنامه نصب می شود."); color: #a5b7ce; wrap: word-wrap; horizontal-alignment: root.english ? left : right; }
     }
     if root.step == 3: VerticalLayout { alignment: center; spacing: 24px;
      Text { text: root.english ? (root.uninstall ? "Removing application…" : "Installing application…") : (root.uninstall ? "در حال حذف برنامه…" : "در حال نصب برنامه…"); color: #f3fcff; font-size: 24px; font-weight: 700; horizontal-alignment: center; }
      ProgressIndicator { progress: root.progress; }
      Text { text: root.message; color: #a5cbd8; wrap: word-wrap; horizontal-alignment: center; }
     }
     if root.step == 4: VerticalLayout { alignment: center; spacing: 22px;
      Text { text: "✓"; color: #69d4e8; font-size: 62px; horizontal-alignment: center; }
      Text { text: root.english ? (root.uninstall ? "Application removed" : "Installation complete") : (root.uninstall ? "برنامه حذف شد" : "نصب کامل شد"); color: #f3fcff; font-size: 26px; font-weight: 700; horizontal-alignment: center; }
      Text { text: root.install-path; color: #a5b7ce; wrap: word-wrap; horizontal-alignment: center; }
      if !root.uninstall: CheckBox { text: root.english ? "Launch MAXI SOUNDSET" : "اجرای MAXI SOUNDSET"; checked <=> root.launch-app; }
      if root.uninstall: Text { text: root.delete-data ? (root.english ? "Settings and logs were removed." : "تنظیمات و لاگ ها حذف شدند.") : (root.english ? "Your settings and logs have been kept." : "تنظیمات و لاگ های تو حفظ شدند."); color: #a5b7ce; wrap: word-wrap; horizontal-alignment: center; }
     }
     if root.error != "": Text { text: root.error; color: #ffb5ba; wrap: word-wrap; horizontal-alignment: root.english ? left : right; }
    }
    }
   }
  }
  Rectangle { height: 3px; border-radius: 2px; background: #283c58;
   Rectangle { width: parent.width * (root.step == 3 ? root.progress : (root.step + 1)/5); height: parent.height; background: #69d4e8; animate width { duration: 220ms; easing: ease-out; } }
  }
  HorizontalLayout { spacing: 12px; height: 44px;
   Text { horizontal-stretch: 1; text: root.version-label; color: #96b0c8; vertical-alignment: center; }
   Button { text: root.english ? "Cancel" : "لغو"; danger: true; enabled: !root.busy; visible: root.step != 4; clicked => { root.cancel(); } }
   Button { text: root.english ? "Back" : "قبلی"; enabled: !root.busy && root.step > 0 && root.step < 3; visible: root.step != 4; clicked => { root.back(); } }
   Button { text: root.step == 4 ? (root.english ? "Finish" : "پایان") : root.step == 2 || (root.step == 1 && root.uninstall) ? (root.english ? (root.uninstall ? "Uninstall" : "Install") : (root.uninstall ? "حذف برنامه" : "نصب")) : (root.english ? "Next" : "بعدی"); enabled: !root.busy && !(root.uninstall && root.step == 1 && root.app-running) && (root.uninstall || root.step != 1 || root.accepted); clicked => { root.next(); } }
  }
 }
}
